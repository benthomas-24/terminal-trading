# Get your secret key from Public.com → Settings → Security → API
PUBLIC_API_SECRET=your_secret_key_here

# Optional: if you already have a Bearer token, set it here to skip the exchange step
# PUBLIC_ACCESS_TOKEN=your_bearer_token_here

# Optional: enables the AI-generated news outlook on the News tab.
# Get one at https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
